TRAINING_SUPERVISOR_MIN_TOP_DECILE_LIFT=0
TRAINING_SUPERVISOR_MIN_EXPECTED_VALUE_PCT=0

# Factor evolution scheduler. Light evolution is frequent; heavy calibration stays slower to reduce overfit/API pressure.
FACTOR_EVOLUTION_AUTO_ENABLED=true
FACTOR_EVOLUTION_MARKETS=ASX,US,CN
FACTOR_EVOLUTION_LIGHT_INTERVAL_HOURS=168
FACTOR_EVOLUTION_HEAVY_INTERVAL_HOURS=720
