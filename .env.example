# Server
HOST=127.0.0.1
PORT=8787
PYTHON_BIN=python3
PYTHON_CORE_TIMEOUT_MS=12000
PYTHON_CORE_PERSISTENT=true
PYTHON_CORE_INTERACTIVE_WORKERS=2
PYTHON_CORE_FACTOR_WORKERS=1
PYTHON_CORE_RESEARCH_WORKERS=1
PYTHON_CORE_INGEST_WORKERS=1
