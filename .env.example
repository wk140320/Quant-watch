FACTOR_CACHE_TTL_MS=600000
MACRO_CACHE_TTL_MS=1800000
SEC_FILINGS_CACHE_TTL_MS=1800000
PREDICTION_SAMPLE_LIMIT=0
MARKET_HISTORY_CACHE_MAX_BYTES=8000000
QUANT_DATA_LAKE_PATH=
DATA_LAKE_BACKFILL_TIMEOUT_MS=180000
ALPHAVANTAGE_MIN_GAP_MS=1300

# Historical prediction calibration. Larger values improve research depth but take longer.
HISTORICAL_BACKTEST_MIN_TRAIN=120
HISTORICAL_BACKTEST_STEP=5
HISTORICAL_BACKTEST_STEP_SCHEDULE=2,3,5
HISTORICAL_BACKTEST_MAX_STEP_OFFSETS=2
HISTORICAL_BACKTEST_MAX_PREDICTIONS=1400
HISTORICAL_BACKTEST_RETRAIN_INTERVAL=60
HISTORICAL_BACKTEST_TRAIN_WINDOW=240
HISTORICAL_BACKTEST_KNN_WINDOW=260
HISTORICAL_BACKTEST_TIMEOUT_MS=60000
HISTORICAL_BACKTEST_BATCH_STEP=4
HISTORICAL_BACKTEST_BATCH_STEP_SCHEDULE=2,3,5,4
HISTORICAL_BACKTEST_BATCH_MAX_STEP_OFFSETS=2
HISTORICAL_BACKTEST_BATCH_TIMEOUT_MS=360000
HISTORICAL_BACKTEST_CALIBRATION_SYMBOL_LIMIT=12
HISTORICAL_BACKTEST_LEGACY_CALIBRATION_ENABLED=false
HISTORICAL_BACKTEST_LARGE_SAMPLE_LIMIT=550
HISTORICAL_BACKTEST_RANGE_US=10y
HISTORICAL_BACKTEST_RANGE_ASX=10y
HISTORICAL_BACKTEST_RANGE_CN=8y
# Production breadth targets are evidence gates. FETCH_CAP controls the quota-safe increment per job.
HISTORICAL_BACKTEST_TARGET_SYMBOLS_US=450
HISTORICAL_BACKTEST_TARGET_SYMBOLS_ASX=350
HISTORICAL_BACKTEST_TARGET_SYMBOLS_CN=550
HISTORICAL_BACKTEST_FETCH_CAP=550
HISTORICAL_BACKTEST_FETCH_CAP_ASX=350
HISTORICAL_BACKTEST_FETCH_CAP_US=450
HISTORICAL_BACKTEST_FETCH_CAP_CN=550
HISTORICAL_BACKTEST_BATCH_MAX_SYMBOLS=1500
TRANSACTION_COST_BPS_US=12
TRANSACTION_COST_BPS_ASX=18
TRANSACTION_COST_BPS_CN=20

# Market-level multi-task OOF training. Run through POST /api/jobs/backtest so the page stays responsive.
PRODUCTION_MODEL_FOLD_COUNT=5
PRODUCTION_MODEL_HORIZONS=5
PRODUCTION_MODEL_EMBARGO_DAYS=7
PRODUCTION_MODEL_MIN_TRAIN_DATES=500
PRODUCTION_MODEL_TEST_DATES=120
# The persistent worker runs one market at a time with at most two model threads.
# Baseline sklearn models and one shallow tree Challenger are enabled by default.
PRODUCTION_SKLEARN_ENABLED=true
PRODUCTION_MODEL_TREE_ENABLED=true
PRODUCTION_BASELINE_MAX_ROWS=6000
PRODUCTION_QUANTILE_MAX_ROWS=6000
PRODUCTION_TREE_BACKEND=catboost
PRODUCTION_TREE_MAX_ROWS=40000
PRODUCTION_TREE_ITERATIONS=72
PRODUCTION_TREE_EARLY_STOPPING_ROUNDS=12
PRODUCTION_TREE_THREADS=2
PRODUCTION_MODEL_TIMEOUT_MS=3600000
# Training reads only historically verified PIT rows; keep the per-symbol window bounded.
PRODUCTION_MODEL_PIT_ROWS_PER_SYMBOL=600
MODEL_REPORT_TIMEOUT_MS=180000
MODEL_REPORT_JOB_AUDIT_LIMIT=400
# Local per-symbol/tree challengers follow the same opt-in resource policy.
LOCAL_MODEL_TREE_ENABLED=false
TRAINING_SUPERVISOR_MIN_HORIZON_MODELS=1
PIT_ENRICHMENT_SYMBOL_LIMIT=60
# Leave cadence blank to use the adaptive policy: daily before stage one, weekly after.
PIT_ENRICHMENT_REFRESH_MS=
PIT_OFFICIAL_SYMBOLS_PER_RUN=20
PIT_ENRICHMENT_CONCURRENCY=4
HISTORY_REPLENISHMENT_REFRESH_MS=
STAGE_ONE_READINESS_CHECK_MS=86400000
DELISTED_UNIVERSE_CACHE_MS=2592000000
ASX_PIT_ANNOUNCEMENT_YEARS=8
ASX_PIT_ANNOUNCEMENT_INTERVAL_MS=140
ASX_PIT_ANNOUNCEMENT_CACHE_MS=15552000000
PIT_CACHE_STARTUP_BACKFILL_ENABLED=false
DATA_LAKE_AUDIT_CADENCE_MS=86400000
DATA_LAKE_AUDIT_TIMEOUT_MS=180000
PRODUCTION_MODEL_MAX_WEIGHT=0.35
PRODUCTION_MODEL_MAX_RESIDUAL_CORRELATION=0.80
OOF_RECOVERY_TIMEOUT_MS=120000
FACTOR_EVOLUTION_FETCH_CONCURRENCY=4

# Persistent AI training supervisor. Deterministic OOF gates remain authoritative;
# AI reviewers can request stricter rework but cannot lower acceptance thresholds.
TRAINING_SUPERVISOR_ENABLED=true
TRAINING_SUPERVISOR_AUTOCYCLE_ENABLED=false
TRAINING_SUPERVISOR_MARKETS=ASX,US,CN
TRAINING_SUPERVISOR_CHECK_MS=60000
TRAINING_SUPERVISOR_STARTUP_DELAY_MS=120000
TRAINING_SUPERVISOR_CADENCE_HOURS=24
TRAINING_SUPERVISOR_MAX_ATTEMPTS=3
TRAINING_SUPERVISOR_RETRY_DELAY_MS=60000
TRAINING_SUPERVISOR_ATTENTION_RETRY_HOURS=6
TRAINING_SUPERVISOR_MAX_JOB_AGE_MS=4500000
TRAINING_SUPERVISOR_MIN_AI_APPROVALS=2
TRAINING_SUPERVISOR_AI_TIMEOUT_MS=45000
TRAINING_SUPERVISOR_BASE_SYMBOL_LIMIT=100
TRAINING_SUPERVISOR_MAX_SYMBOLS=650
TRAINING_SUPERVISOR_RANGE_ASX=10y
TRAINING_SUPERVISOR_RANGE_US=10y
TRAINING_SUPERVISOR_RANGE_CN=8y
TRAINING_SUPERVISOR_HORIZON_DAYS=5
TRAINING_SUPERVISOR_TARGET_UPSIDE=5
TRAINING_SUPERVISOR_STOP_LOSS=4
TRAINING_SUPERVISOR_MIN_ROWS=50000
TRAINING_SUPERVISOR_MIN_SYMBOLS=100
TRAINING_SUPERVISOR_MIN_HORIZON_MODELS=1
TRAINING_SUPERVISOR_MIN_OOF_ROWS=1000
TRAINING_SUPERVISOR_MIN_META_TEST_ROWS=1000
