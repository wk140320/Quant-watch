# Broker readiness. Live order execution remains disabled by the application.
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=7497
IBKR_CLIENT_ID=17
IBKR_ALLOW_LIVE_TRADING=false

# Cache and tuning
MARKET_CACHE_TTL_MS=60000
QUOTE_CACHE_TTL_MS=30000
QUOTE_ASX_MAX_AGE_MS=1200000
QUOTE_US_MAX_AGE_MS=300000
QUOTE_CN_MAX_AGE_MS=300000
QUOTE_CROSS_SOURCE_MAX_DIFF_PCT=2
QUOTE_STRICT_PRIMARY_COUNT=3
