# Server
HOST=127.0.0.1
PORT=8787

# Analysis
ENABLE_OPENAI_ANALYSIS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=12000
OPENAI_BATCH_TIMEOUT_MS=10000

# Market providers
MARKET_PROVIDER=dual
ASX_MARKET_PROVIDER=dual
US_MARKET_PROVIDER=dual
CN_MARKET_PROVIDER=dual
CN_ENABLE_KEYED_FALLBACKS=true
CN_ENABLE_EXTRA_KEYED_FALLBACKS=false
US_REQUIRE_DUAL_SOURCE=false
MARKET_ALLOW_CONFLICT=false
MARKET_PRICE_DIFF_MAX_PCT=2
SINGLE_SOURCE_CONFIDENCE_PENALTY=5
REALTIME_QUOTE_MAX_DIFF_PCT=35

# API keys, optional. Leave blank to use only providers that do not require keys.
EODHD_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
STOOQ_API_KEY=

# News and social providers, optional.
NEWSAPI_KEY=
NEWSDATA_API_KEY=
THENEWSAPI_KEY=
TIANAPI_KEY=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=

# Cache and tuning
MARKET_CACHE_TTL_MS=60000
QUOTE_CACHE_TTL_MS=30000
NEWS_CACHE_TTL_MS=600000
FACTOR_CACHE_TTL_MS=600000
SEC_FILINGS_CACHE_TTL_MS=1800000
PREDICTION_SAMPLE_LIMIT=3000
ALPHAVANTAGE_MIN_GAP_MS=1300

# SEC requires a real contact string for production use.
SEC_USER_AGENT=GlobalQuantWatch/1.0 contact@example.com
