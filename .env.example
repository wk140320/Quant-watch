# Server
HOST=127.0.0.1
PORT=8787
PYTHON_BIN=python3
PYTHON_CORE_TIMEOUT_MS=12000

# Analysis
ENABLE_OPENAI_ANALYSIS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=12000
OPENAI_BATCH_TIMEOUT_MS=10000
ENABLE_DOMESTIC_AI_ANALYSIS=false
AI_PROVIDER_ORDER=openai,siliconflow,hunyuan
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_MODEL=deepseek-v3.2

# Market providers
MARKET_PROVIDER=dual
ASX_MARKET_PROVIDER=dual
US_MARKET_PROVIDER=dual
CN_MARKET_PROVIDER=dual
CN_ENABLE_KEYED_FALLBACKS=true
CN_ENABLE_EXTRA_KEYED_FALLBACKS=false
US_REQUIRE_DUAL_SOURCE=false
MARKET_ALLOW_CONFLICT=false
MARKET_PRICE_DIFF_MAX_PCT=2
SINGLE_SOURCE_CONFIDENCE_PENALTY=5
REALTIME_QUOTE_MAX_DIFF_PCT=35

# API keys, optional. Leave blank to use only providers that do not require keys.
EODHD_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
STOOQ_API_KEY=
TUSHARE_TOKEN=
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Official Alpaca SDK/env aliases are also accepted by the app:
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_TRADES_LIMIT=1000
FINNHUB_API_KEY=
TIINGO_API_KEY=
ATAS_API_KEY=
ATAS_BASE_URL=
ATAS_FEATURE_ENDPOINT=
ATAS_TIMEOUT_MS=10000

# News and social providers, optional.
NEWS_PRIMARY_PROVIDER=
NEWSAPI_KEY=
NEWSDATA_API_KEY=
THENEWSAPI_KEY=
TIANAPI_KEY=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
MARKETAUX_API_KEY=
FRED_API_KEY=
REDDIT_ENABLED=true
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_ENV_PATH=
REDDIT_PACKAGE_PATH=
REDDIT_PYTHON_BIN=
REDDIT_REFRESH_MS=3600000
REDDIT_TIMEOUT_MS=6500
REDDIT_BACKGROUND_TIMEOUT_MS=20000
REDDIT_BACKGROUND_MAX_SYMBOLS=80
REDDIT_BACKGROUND_POSTS_PER_SUBREDDIT=6
REDDIT_BACKGROUND_GAP_MS=450
REDDIT_POOL_KEYWORDS_MAX=18
REDDIT_POOL_POSTS_PER_SOURCE=8
REDDIT_API_ITEMS_LIMIT=20

# Broker readiness. Live order execution remains disabled by the application.
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=7497
IBKR_CLIENT_ID=17
IBKR_ALLOW_LIVE_TRADING=false

# Cache and tuning
MARKET_CACHE_TTL_MS=60000
QUOTE_CACHE_TTL_MS=30000
NEWS_CACHE_TTL_MS=600000
FACTOR_CACHE_TTL_MS=600000
MACRO_CACHE_TTL_MS=1800000
SEC_FILINGS_CACHE_TTL_MS=1800000
PREDICTION_SAMPLE_LIMIT=0
MARKET_HISTORY_CACHE_MAX_BYTES=8000000
ALPHAVANTAGE_MIN_GAP_MS=1300

# Historical prediction calibration. Larger values improve research depth but take longer.
HISTORICAL_BACKTEST_MIN_TRAIN=120
HISTORICAL_BACKTEST_STEP=5
HISTORICAL_BACKTEST_STEP_SCHEDULE=2,3,5
HISTORICAL_BACKTEST_MAX_STEP_OFFSETS=2
HISTORICAL_BACKTEST_MAX_PREDICTIONS=1400
HISTORICAL_BACKTEST_RETRAIN_INTERVAL=60
HISTORICAL_BACKTEST_TRAIN_WINDOW=240
HISTORICAL_BACKTEST_KNN_WINDOW=260
HISTORICAL_BACKTEST_TIMEOUT_MS=18000
HISTORICAL_BACKTEST_BATCH_STEP=4
HISTORICAL_BACKTEST_BATCH_STEP_SCHEDULE=2,3,5,4
HISTORICAL_BACKTEST_BATCH_MAX_STEP_OFFSETS=2
HISTORICAL_BACKTEST_BATCH_TIMEOUT_MS=65000
HISTORICAL_BACKTEST_LARGE_SAMPLE_LIMIT=80

# Factor evolution scheduler. Light evolution is frequent; heavy calibration stays slower to reduce overfit/API pressure.
FACTOR_EVOLUTION_AUTO_ENABLED=true
FACTOR_EVOLUTION_MARKETS=ASX,US,CN
FACTOR_EVOLUTION_LIGHT_INTERVAL_HOURS=12
FACTOR_EVOLUTION_HEAVY_INTERVAL_HOURS=168
FACTOR_EVOLUTION_LIGHT_SYMBOL_LIMIT=12
FACTOR_EVOLUTION_HEAVY_SYMBOL_LIMIT=80
FACTOR_EVOLUTION_RANGE=5y
FACTOR_EVOLUTION_HORIZON_DAYS=15
FACTOR_EVOLUTION_LIGHT_GENERATIONS=6
FACTOR_EVOLUTION_LIGHT_POPULATION=36
FACTOR_EVOLUTION_CHECK_INTERVAL_MS=600000
FACTOR_EVOLUTION_STARTUP_DELAY_MS=90000
FACTOR_EVOLUTION_TIMEOUT_MS=32000
FACTOR_EVOLUTION_RUN_HEAVY_ON_FIRST_START=false

# Backend live monitor. Runs without the frontend page being open.
BACKEND_MONITOR_ENABLED=true
BACKEND_MONITOR_HOLDING_REFRESH_MS=300000
BACKEND_MONITOR_WATCH_REFRESH_MS=900000
BACKEND_MONITOR_TRAINING_ENABLED=true
BACKEND_MONITOR_TRAINING_REFRESH_MS=300000
BACKEND_MONITOR_TRAINING_SYMBOL_LIMIT=3
BACKEND_MONITOR_TRAINING_INTERVAL=5m
BACKEND_MONITOR_TRAINING_RANGE=5d
BACKEND_MONITOR_CHECK_MS=30000
BACKEND_MONITOR_STARTUP_DELAY_MS=45000
BACKEND_MONITOR_MAX_SYMBOLS_PER_TICK=10
BACKEND_MONITOR_CONCURRENCY=2
BACKEND_MONITOR_ALLOW_OFF_HOURS_FETCH=false
BACKEND_MONITOR_AI_ENABLED=false
BACKEND_MONITOR_DAILY_MARKET_CALL_LIMIT=520
BACKEND_MONITOR_DAILY_FACTOR_CALL_LIMIT=120
BACKEND_MONITOR_DAILY_AI_CALL_LIMIT=30
BACKEND_MONITOR_DAILY_TRAINING_CALL_LIMIT=96
BACKEND_MONITOR_TRAINING_MARKET_RESERVE=90
BACKEND_MONITOR_DAILY_NOTIFICATION_LIMIT=120
BACKEND_MONITOR_ALERT_DEDUPE_MS=7200000
BACKEND_MONITOR_DESKTOP_NOTIFICATIONS=true
BACKEND_MONITOR_MOBILE_NOTIFICATIONS=true
MOBILE_PUSH_WEBHOOK_URL=
BARK_PUSH_URL=
PUSHPLUS_TOKEN=
SERVERCHAN_SENDKEY=

# SEC requires a real contact string for production use.
SEC_USER_AGENT=GlobalQuantWatch/1.0 contact@example.com
